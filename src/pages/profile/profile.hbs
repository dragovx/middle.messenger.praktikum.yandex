<main class="profile">
  <aside class="profile__side">
    <a href="#messenger" class="profile__side-button" aria-label="Назад к чатам">
      <img class="profile__side-ico" src="/img/back.svg">
    </a>
  </aside>

  <section class="profile__content">
    <div class="profile__header">
      <div class="profile__avatar-wrapper">
      {{#if (routePath '#profile')}}
        <form
          class="profile__avatar-form"
          method="post"
          enctype="multipart/form-data"
        >
          <input
            class="profile__avatar-input"
            type="file"
            name="avatar"
            id="avatar"
            accept="image/*"
            hidden
          >
          <label class="profile__avatar-label" for="avatar">
            {{/if}}
            <img src="/img/profileAvatar.png" alt="avatar" class="profile__avatar"/>
            {{#if (routePath '#profile')}}
            <span class="profile__avatar-overlay">
              <div>Поменять</div>
              <div>аватар</div>
            </span>
          </label>
        </form>
      {{/if}}
    </div>
      {{#if (routePath '#profile')}}
        {{{ Heading text = "Иван" modifier = "profile" }}}
      {{/if}}
    </div>
    {{#if (or (routePath '#profile') (routePath '#profile/edit'))}}
      <form class="profile__info-form">
        {{{ ProfileEditRow readonly=(routePath "#profile") label="Почта" name="email" type="email" value=email  }}} 
        {{{ ProfileEditRow readonly=(routePath "#profile") label="Логин" name="login" type="text" value=login }}}
        {{{ ProfileEditRow readonly=(routePath "#profile") label="Имя" name="first_name" type="text" value=first_name }}}
        {{{ ProfileEditRow readonly=(routePath "#profile") label="Фамилия" name="second_name" type="text" value=second_name }}}
        {{{ ProfileEditRow readonly=(routePath "#profile") label="Имя в чате" name="display_name" type="text" value=display_name }}}
        {{{ ProfileEditRow readonly=(routePath "#profile") label="Телефон" name="phone" type="tel" value=phone }}}
        {{#if (routePath '#profile/edit')}}
        <div class="profile__info-button">
          {{{ Button label = 'Сохранить' modifier = 'changeProfile' type = 'submit' }}}
        </div>
        {{/if}}
      </form>
    {{/if}}
    
    {{#if (routePath '#profile/password') }}
    <form class="profile__change-password-from">
      {{{ ProfileEditRow label = "Старый пароль" type = "password" name = "old_password" value = "•••••••••"}}}
      {{{ ProfileEditRow label = "Новый пароль" type = "password" name = "new_password" value = "•••••••••" }}}
      {{{ ProfileEditRow label = "Повторите новый пароль" type = "password" name = "repeat_password" value = "•••••••••"}}}
      <div class="profile__info-button">
        {{{ Button label = 'Сохранить' modifier = 'changePassword' type = 'submit' }}}
      </div>
    </form>
    {{/if}}
    {{#if (routePath '#profile') }}
      <nav class="profile__actions">
        {{{ Link modifier="action" href="#profile/edit" text="Изменить данные" }}}
        {{{ Link modifier="action" href="#profile/password" text="Изменить пароль" }}}
        {{{ Link modifier="logout" href="#" text="Выйти" }}}
      </nav>
    {{/if}}
  </section>
</main>