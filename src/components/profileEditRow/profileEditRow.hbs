<div class="profile-field">
  <label class="profile-field__input-wrapper">
    <span class="profile-field__label" for="{{name}}">
      {{label}}
    </span>
    <input class="profile-field__input" id="{{name}}" name="{{name}}" type="{{type}}" value="{{value}}" {{#if readonly}}readonly{{/if}}/>
  </label>
  <span class="profile-field__error"></span>
</div>